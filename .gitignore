# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reference media in docs/ (not needed in production or git remote)
docs/**/*.mp4
docs/**/*.mov
docs/**/*.webm

# Camera RAW files (original photography raw files, not used in web build)
*.ARW
*.arw
*.CR2
*.cr2
*.NEF
*.nef
*.DNG
*.dng

